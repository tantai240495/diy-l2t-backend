{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodingTask",
  "type": "object",
  "required": [
    "id",
    "project_id",
    "provider",
    "repo_path",
    "status",
    "acceptance_criteria",
    "required_checks",
    "allowed_actions",
    "forbidden_actions"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "provider": {
      "enum": [
        "claude-code",
        "codex"
      ]
    },
    "repo_path": {
      "type": "string"
    },
    "source_links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "draft",
        "awaiting_brief_approval",
        "planning",
        "awaiting_plan_approval",
        "implementing",
        "testing",
        "awaiting_pr_approval",
        "completed",
        "blocked",
        "failed"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "type": "object"
    }
  }
}